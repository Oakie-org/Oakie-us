# Only needed when running `uvicorn app.main:app` yourself.
# `python scripts/dev_server.py` sets everything for local development, and
# Lambda gets its values from template.yaml.

AUTH_MODE=local
AWS_REGION=us-west-2
# AWS_ENDPOINT_URL=http://127.0.0.1:5050   # moto server, DynamoDB Local or LocalStack
TABLE_NAME=Oakie-Local
UPLOADS_BUCKET_NAME=oakie-local-uploads

# Required when AUTH_MODE=cognito
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=

# Comma-separated web origins, or *
CORS_ORIGINS=*
# user | creator | moderator | admin
PROJECT_CREATION_MIN_ROLE=user
