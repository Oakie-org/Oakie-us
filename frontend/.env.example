# Leave everything unset for local development: the dev server proxies /api to
# http://127.0.0.1:8000 and sign-in uses the backend's local identity provider.

# Deployed API origin (SAM output "ApiUrl"), without a trailing slash.
# VITE_API_BASE_URL=https://xxxxxxxx.execute-api.us-west-2.amazonaws.com

# "cognito" for a deployed stack, "local" for the dev backend.
# VITE_AUTH_MODE=cognito

# SAM outputs "UserPoolId" and "ClientId".
# VITE_COGNITO_USER_POOL_ID=us-west-2_XXXXXXXXX
# VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
